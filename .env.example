# Copy to .env and fill in. Never commit .env.

# --- Genosai (required) — one key for LLM, TTS, images, video, music. Starts with sdk_...
GENOSAI_API_KEY=
# GENOSAI_API_HOST=https://api.genosai.io

# --- Free stock footage (optional; without them visual_source=stock falls back to ai_image)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Server
CANNON_HOST=127.0.0.1
CANNON_PORT=8787
CANNON_LOG_LEVEL=INFO

# --- Pipeline
# how many tasks may render at the same time
CANNON_MAX_PARALLEL_TASKS=2
# Remotion --concurrency (0 = Remotion default = half of CPU cores)
CANNON_RENDER_CONCURRENCY=0
# where tasks/cache live (default: ./storage next to the package)
# CANNON_STORAGE=/app/storage
